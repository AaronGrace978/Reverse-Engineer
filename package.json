{
  "name": "reverse-engineer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An evidence-led AI research and reverse engineering desktop workspace",
  "author": "AaronGrace978",
  "license": "UNLICENSED",
  "main": "dist-electron/main.cjs",
  "desktopName": "reverse-engineer.desktop",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build:desktop": "node scripts/build-electron.mjs",
    "build": "tsc --noEmit && vite build && npm run build:desktop",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "postinstall": "install-electron",
    "dist": "npm run build && electron-builder --publish never",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "katex": "^0.19.1",
    "lucide-react": "^0.468.0",
    "mathjs": "^15.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "unpdf": "^1.3.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.0.0"
  },
  "overrides": { "katex": "$katex" },
  "build": {
    "appId": "dev.reverseengineer.desktop",
    "productName": "Reverse Engineer",
    "icon": "build/icon.png",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "asar": true,
    "publish": [{ "provider": "github", "owner": "AaronGrace978", "repo": "Reverse-Engineer" }],
    "win": { "target": "nsis" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools", "hardenedRuntime": true },
    "linux": { "target": "AppImage", "category": "Development", "syncDesktopName": true }
  }
}
